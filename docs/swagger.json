{
  "openapi": "3.0.3",
  "info": {
    "title": "B2B-Promo API",
    "version": "1.0.1",
    "description": "식자재 유통사가 B2B 거래처에게 프로모션을 안내하고 참여 신청(및 선착순 쿠폰 이벤트 즉시 추첨)을 받는 API. docs/1-domain-definition.md(v1.5), docs/3-prd.md(v1.5), docs/9-plan.md 기준으로 작성된 MVP 범위 스펙이다."
  },
  "servers": [
    { "url": "/api", "description": "백엔드 API 서버 (경로 프리픽스는 배포 환경에 따라 다를 수 있음)" }
  ],
  "tags": [
    { "name": "Auth", "description": "회원가입/로그인/토큰 재발급 (UC-1)" },
    { "name": "Promotions", "description": "거래처 담당자용 프로모션 조회 (UC-2)" },
    { "name": "Applications", "description": "참여 신청/취소/내 신청 목록 (UC-3, UC-4, UC-5)" },
    { "name": "Admin Promotions", "description": "관리자용 프로모션 등록/수정/게시·종료/참여 현황 (UC-6, UC-7, UC-8)" },
    { "name": "Users", "description": "마이페이지 (UC-9)" }
  ],
  "security": [
    { "bearerAuth": [] }
  ],
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "거래처 담당자 회원가입 (UC-1, BR-2)",
        "description": "거래처 담당자 계정만 가입 가능하다. User와 Partner를 하나의 트랜잭션으로 동시 생성한다(1:1). 관리자 계정은 회원가입 대상이 아니다(BR-2, 시딩으로만 생성).",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SignupRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "회원가입 성공 (User + Partner 생성됨)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user": { "$ref": "#/components/schemas/User" },
                    "partner": { "$ref": "#/components/schemas/Partner" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": {
            "description": "이미 가입된 이메일 (중복 가입 시도)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "이미 가입된 이메일입니다." }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "로그인 (UC-1) - Access/Refresh Token 발급",
        "description": "이메일/비밀번호 검증 성공 시 Access Token(짧은 만료)과 Refresh Token(긴 만료)을 함께 발급한다(PRD 6.3절). 두 토큰 모두 클라이언트가 저장하며, httpOnly 쿠키는 사용하지 않는다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "로그인 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AuthTokenResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": {
            "description": "이메일 또는 비밀번호 불일치",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "이메일 또는 비밀번호가 올바르지 않습니다." }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Access Token 재발급 (PRD 6.3절)",
        "description": "Access Token 만료(401) 시 클라이언트가 저장해둔 Refresh Token을 요청 바디로 전송하면 서버가 이를 검증(stateless)하여 새 Access Token을 발급한다.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RefreshRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "재발급 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": { "type": "string" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Refresh Token이 유효하지 않거나 만료됨",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "유효하지 않은 Refresh Token입니다. 다시 로그인해주세요." }
              }
            }
          }
        }
      }
    },
    "/promotions": {
      "get": {
        "tags": ["Promotions"],
        "summary": "게시된 프로모션 목록 조회 (UC-2, BR-9, BR-10)",
        "description": "status=published 프로모션만 반환한다(BR-9). 임시저장(draft)·종료(closed) 프로모션은 제외된다(BR-10). 쿠폰 이벤트가 부착된 프로모션은 capacity/applied_count(잔여 정원 계산용)를 포함한다.",
        "responses": {
          "200": {
            "description": "게시된 프로모션 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Promotion" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/promotions/{id}": {
      "get": {
        "tags": ["Promotions"],
        "summary": "프로모션 상세 조회 (UC-2)",
        "parameters": [
          { "$ref": "#/components/parameters/PromotionId" }
        ],
        "responses": {
          "200": {
            "description": "프로모션 상세",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Promotion" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/promotions/{id}/apply": {
      "post": {
        "tags": ["Applications"],
        "summary": "프로모션 참여 신청 (UC-3, UC-4, BR-3~8, EX-1~4)",
        "description": "참여신청은 (프로모션, 거래처) 조합당 1건이며 상태 전환 방식으로 처리한다(BR-3). 쿠폰 이벤트가 부착된 프로모션이면 신청 성공 시 서버가 즉시 확률분포(5%=40%/10%=30%/15%=20%/20%=10%)에 따라 할인율을 추첨해 응답에 포함한다(BR-4). 쿠폰 이벤트는 선착순 50명까지만 성공하며 취소해도 슬롯은 반환되지 않는다(BR-6, BR-7).",
        "parameters": [
          { "$ref": "#/components/parameters/PromotionId" }
        ],
        "responses": {
          "201": {
            "description": "신청 성공 (쿠폰 이벤트가 있으면 draw_result 포함)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApplyResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "현재 리소스 상태와의 충돌: 종료된 프로모션에 신규 신청(EX-3), 중복 신청(EX-2), 쿠폰 이벤트 선착순 50명 마감(EX-1, EX-4)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "examples": {
                  "promotionClosed": {
                    "summary": "종료된 프로모션에 신규 신청 시도 (EX-3, BR-11)",
                    "value": { "error": "종료된 프로모션에는 신청할 수 없습니다." }
                  },
                  "duplicate": {
                    "summary": "이미 신청됨 상태에서 중복 신청 (EX-2)",
                    "value": { "error": "이미 신청한 프로모션입니다." }
                  },
                  "closed": {
                    "summary": "쿠폰 이벤트 선착순 50명 마감 (EX-1, EX-4)",
                    "value": { "error": "마감되었습니다." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/applications/me": {
      "get": {
        "tags": ["Applications"],
        "summary": "내 참여신청 목록 조회 (UC-5, BR-8, BR-10)",
        "description": "로그인한 거래처 담당자의 신청 이력을 상태(신청됨/취소됨) 무관하게 전체 반환한다. 종료된 프로모션에 대한 신청 건도 계속 포함된다(BR-10). 쿠폰 이벤트 당첨 건은 할인율/만료일(BR-8)을 함께 반환한다.",
        "responses": {
          "200": {
            "description": "내 참여신청 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Application" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/applications/{id}/cancel": {
      "patch": {
        "tags": ["Applications"],
        "summary": "참여신청 취소 (UC-5, BR-11)",
        "description": "신청 상태를 취소됨으로 전환한다(새 레코드 생성 없음). 프로모션이 종료(closed)되어도 기존 신청 취소는 허용된다(BR-11). 쿠폰 이벤트의 applied_count는 감소하지 않는다(BR-6, 슬롯 미반환). 본인 소유 신청건만 취소 가능하다.",
        "parameters": [
          { "$ref": "#/components/parameters/ApplicationId" }
        ],
        "responses": {
          "200": {
            "description": "취소 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Application" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": {
            "description": "타 거래처 소유의 신청건은 취소할 수 없음",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "본인 소유의 신청건만 취소할 수 있습니다." }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/promotions": {
      "get": {
        "tags": ["Admin Promotions"],
        "summary": "관리자용 전체 프로모션 목록 조회 (UC-6, UC-7)",
        "description": "관리자 권한 필요(403). 임시저장(draft)/게시됨(published)/종료됨(closed) 프로모션을 모두 반환한다.",
        "responses": {
          "200": {
            "description": "전체 프로모션 목록",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Promotion" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["Admin Promotions"],
        "summary": "프로모션 등록 (UC-6, UC-7, BR-6)",
        "description": "관리자 권한 필요(403). status는 draft(임시저장, UC-6) 또는 published(게시)로 지정할 수 있다. coupon_event를 true로 지정하면 capacity=50 고정의 쿠폰 이벤트가 함께 생성된다(BR-6).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminPromotionCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "등록 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Promotion" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/admin/promotions/{id}": {
      "put": {
        "tags": ["Admin Promotions"],
        "summary": "프로모션 수정 (UC-7)",
        "description": "관리자 권한 필요(403). 제목/유형/설명을 수정한다. 게시/종료 상태 전환은 별도의 `/admin/promotions/{id}/status` 엔드포인트를 사용한다.",
        "parameters": [
          { "$ref": "#/components/parameters/PromotionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminPromotionUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Promotion" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/promotions/{id}/status": {
      "patch": {
        "tags": ["Admin Promotions"],
        "summary": "프로모션 게시/종료 상태 전환 (UC-7, BR-9)",
        "description": "관리자 권한 필요(403). status를 published(게시)로 전환하면 거래처 담당자 목록에 즉시 노출되고(BR-9), closed(종료)로 전환하면 목록에서 제외된다(BR-10). 이미 존재하는 참여신청 취소는 종료 이후에도 계속 허용된다(BR-11, 참고).",
        "parameters": [
          { "$ref": "#/components/parameters/PromotionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AdminPromotionStatusRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "상태 전환 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Promotion" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/admin/promotions/{id}/applications": {
      "get": {
        "tags": ["Admin Promotions"],
        "summary": "프로모션별 참여 현황 조회 (UC-8)",
        "description": "관리자 권한 필요(403). 신청됨/취소됨 건수, 쿠폰 이벤트가 있으면 applied_count/capacity, 할인율(5/10/15/20)별 당첨 분포, 신청 거래처 목록을 반환한다.",
        "parameters": [
          { "$ref": "#/components/parameters/PromotionId" }
        ],
        "responses": {
          "200": {
            "description": "참여 현황",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/AdminApplicationsSummary" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "내 정보 조회 (UC-9)",
        "description": "로그인한 사용자(거래처 담당자/관리자 공통)의 정보를 반환한다. password_hash는 응답에 포함되지 않는다.",
        "responses": {
          "200": {
            "description": "내 정보",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "내 정보 수정 (UC-9)",
        "description": "이름/전화번호를 수정한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UsersMeUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "수정 성공",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    },
    "/users/me/password": {
      "patch": {
        "tags": ["Users"],
        "summary": "비밀번호 변경 (UC-9)",
        "description": "현재 비밀번호 확인 후 새 비밀번호로 bcrypt 재해시하여 저장한다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UsersMePasswordRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "변경 성공",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "비밀번호가 변경되었습니다." }
                  }
                }
              }
            }
          },
          "400": {
            "description": "현재 비밀번호 불일치",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" },
                "example": { "error": "현재 비밀번호가 올바르지 않습니다." }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Access Token을 `Authorization: Bearer <token>` 헤더로 전송한다. 만료(401) 시 `/auth/refresh`로 재발급 후 재시도한다(PRD 6.3절)."
      }
    },
    "parameters": {
      "PromotionId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "프로모션 ID",
        "schema": { "type": "integer" }
      },
      "ApplicationId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "참여신청 ID",
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "필수 필드 누락 등 요청 검증 실패",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "Unauthorized": {
        "description": "로그인하지 않았거나 Access Token이 없음/만료/위조됨 (BR-1, EX-5)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "인증이 필요합니다." }
          }
        }
      },
      "Forbidden": {
        "description": "관리자 권한 필요(403) - 거래처 담당자 계정으로는 접근 불가",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" },
            "example": { "error": "관리자 권한이 필요합니다." }
          }
        }
      },
      "NotFound": {
        "description": "리소스를 찾을 수 없음",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "description": "사용자에게 보여줄 에러 메시지" }
        },
        "required": ["error"]
      },
      "User": {
        "type": "object",
        "description": "로그인 계정 (도메인 정의서 2-1절)",
        "properties": {
          "id": { "type": "integer" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["partner", "admin"], "description": "거래처담당자/관리자" },
          "name": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "Partner": {
        "type": "object",
        "description": "거래처 (User와 1:1)",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string", "description": "거래처명" },
          "user_id": { "type": "integer" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "CouponEvent": {
        "type": "object",
        "description": "프로모션에 선택적으로 부착되는 랜덤 쿠폰 뽑기 이벤트 (선착순 50명 한정)",
        "properties": {
          "id": { "type": "integer" },
          "promotion_id": { "type": "integer" },
          "capacity": { "type": "integer", "enum": [50], "example": 50, "description": "정원, 고정값 50" },
          "applied_count": { "type": "integer", "description": "누적 신청 성공 수. 취소해도 감소하지 않음(BR-6, 슬롯 미반환)" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Promotion": {
        "type": "object",
        "description": "프로모션 (도메인 정의서 2-1절)",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["price_discount", "sample", "tasting", "bogo"],
            "description": "가격할인/샘플증정/신제품시식/1+1"
          },
          "description": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "closed"],
            "description": "임시저장/게시됨/종료됨 (BR-9)"
          },
          "created_by": { "type": "integer", "description": "등록한 관리자 User.id" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" },
          "coupon_event": {
            "allOf": [{ "$ref": "#/components/schemas/CouponEvent" }],
            "nullable": true,
            "description": "쿠폰 이벤트가 없는 프로모션은 null"
          }
        }
      },
      "DrawResult": {
        "type": "object",
        "description": "쿠폰 이벤트 추첨 결과 (참여신청 1건당 최대 1건, 재추첨 없음)",
        "properties": {
          "id": { "type": "integer" },
          "application_id": { "type": "integer" },
          "discount_rate": { "type": "number", "enum": [5, 10, 15, 20], "description": "당첨 할인율(%)" },
          "confirmed_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time", "description": "confirmed_at + 1개월. 이 시점까지만 사용 가능하다고 안내(BR-8)" }
        }
      },
      "Application": {
        "type": "object",
        "description": "참여신청 (프로모션, 거래처) 조합당 1건",
        "properties": {
          "id": { "type": "integer" },
          "promotion_id": { "type": "integer" },
          "partner_id": { "type": "integer" },
          "status": { "type": "string", "enum": ["applied", "canceled"], "description": "신청됨/취소됨 (BR-3)" },
          "applied_at": { "type": "string", "format": "date-time" },
          "canceled_at": { "type": "string", "format": "date-time", "nullable": true },
          "promotion": {
            "allOf": [{ "$ref": "#/components/schemas/Promotion" }],
            "description": "GET /applications/me 응답에 포함되는 소속 프로모션 정보(종료된 프로모션도 계속 포함, BR-10)"
          },
          "draw_result": {
            "allOf": [{ "$ref": "#/components/schemas/DrawResult" }],
            "nullable": true,
            "description": "쿠폰 이벤트 당첨 결과가 있는 경우에만 포함, 없으면 null"
          }
        }
      },
      "SignupRequest": {
        "type": "object",
        "required": ["email", "password", "name", "partner_name"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password", "minLength": 8 },
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "partner_name": { "type": "string", "description": "거래처명 (Partner.name)" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string", "format": "password" }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": ["refresh_token"],
        "properties": {
          "refresh_token": { "type": "string" }
        }
      },
      "AuthTokenResponse": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" },
          "user": { "$ref": "#/components/schemas/User" }
        }
      },
      "ApplyResponse": {
        "type": "object",
        "properties": {
          "application": { "$ref": "#/components/schemas/Application" },
          "draw_result": {
            "allOf": [{ "$ref": "#/components/schemas/DrawResult" }],
            "nullable": true,
            "description": "쿠폰 이벤트가 없는 프로모션이면 null"
          }
        }
      },
      "AdminPromotionCreateRequest": {
        "type": "object",
        "required": ["title", "type"],
        "properties": {
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["price_discount", "sample", "tasting", "bogo"] },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "published"], "default": "draft", "description": "임시저장(UC-6) 또는 게시" },
          "coupon_event": { "type": "boolean", "default": false, "description": "true면 capacity=50 고정 쿠폰 이벤트를 함께 생성 (BR-6)" }
        }
      },
      "AdminPromotionUpdateRequest": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "type": { "type": "string", "enum": ["price_discount", "sample", "tasting", "bogo"] },
          "description": { "type": "string" }
        }
      },
      "AdminPromotionStatusRequest": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "type": "string", "enum": ["published", "closed"], "description": "게시 또는 종료 (BR-9)" }
        }
      },
      "AdminApplicationsSummary": {
        "type": "object",
        "properties": {
          "promotion_id": { "type": "integer" },
          "applied_status_count": { "type": "integer", "description": "현재 status=applied인 건수 (취소 시 감소함. coupon_event.applied_count와는 다른 값 — 그쪽은 누적 신청 성공 수로 취소해도 감소하지 않음, BR-6)" },
          "canceled_count": { "type": "integer", "description": "status=canceled 건수" },
          "coupon_event": {
            "allOf": [{ "$ref": "#/components/schemas/CouponEvent" }],
            "nullable": true
          },
          "discount_distribution": {
            "type": "object",
            "description": "할인율별 당첨 건수 분포",
            "properties": {
              "5": { "type": "integer" },
              "10": { "type": "integer" },
              "15": { "type": "integer" },
              "20": { "type": "integer" }
            }
          },
          "applications": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "partner_name": { "type": "string" },
                "status": { "type": "string", "enum": ["applied", "canceled"] },
                "applied_at": { "type": "string", "format": "date-time" },
                "discount_rate": { "type": "number", "nullable": true }
              }
            }
          }
        }
      },
      "UsersMeUpdateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "UsersMePasswordRequest": {
        "type": "object",
        "required": ["current_password", "new_password"],
        "properties": {
          "current_password": { "type": "string", "format": "password" },
          "new_password": { "type": "string", "format": "password", "minLength": 8 }
        }
      }
    }
  }
}
